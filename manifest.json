{
  "manifest_version": 3,
  "name": "AI Safety Guard v1.2",
  "version": "1.2.3",
  "description": "Proteção local contra o envio de dados sensíveis para chats de IA.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "AI Safety Guard v1.2",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["src/rules.js", "src/detector.js", "src/attachments.js", "src/content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/pdf.mjs", "vendor/pdf.worker.mjs", "vendor/mammoth.browser.min.mjs"],
      "matches": [
        "https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*",
        "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://gemini.google.com/*"
      ]
    }
  ]
}
