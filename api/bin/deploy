#!/usr/bin/env python3
"""Production launcher for the AI Safety Guard Rules API."""

from __future__ import annotations

import argparse
import os
import sys
from collections.abc import Callable, Sequence
from pathlib import Path
from typing import Any


API_ROOT = Path(__file__).resolve().parents[1]
if str(API_ROOT) not in sys.path:
    sys.path.insert(0, str(API_ROOT))


class ConfigurationError(RuntimeError):
    """Raised when runtime settings cannot be loaded."""

    def __init__(self, fields: Sequence[str] = ()) -> None:
        self.fields = tuple(fields)
        super().__init__(", ".join(self.fields) or "configuração desconhecida")


def ensure_virtualenv(
    api_root: Path = API_ROOT,
    argv: Sequence[str] | None = None,
    *,
    prefix: str = sys.prefix,
    base_prefix: str = sys.base_prefix,
    execv: Callable[[str, list[str]], Any] = os.execv,
) -> bool:
    """Re-executes this launcher with the project virtualenv when necessary."""
    if prefix != base_prefix:
        return False
    python = api_root / ".venv" / "bin" / "python"
    if not python.is_file():
        return False
    arguments = [str(python), str(Path(__file__).resolve()), *(argv if argv is not None else sys.argv[1:])]
    execv(str(python), arguments)
    return True


def build_parser(settings: Any) -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Inicia a AI Safety Guard Rules API.")
    parser.add_argument("--host", default=settings.api_host)
    parser.add_argument("--port", type=int, default=settings.api_port)
    parser.add_argument(
        "--log-level",
        choices=("critical", "error", "warning", "info", "debug", "trace"),
        default=settings.log_level,
    )
    return parser


def load_settings() -> Any:
    from app.config import Settings

    try:
        return Settings()
    except Exception as error:
        details = error.errors(include_input=False) if hasattr(error, "errors") else []
        fields = sorted({".".join(map(str, item.get("loc", ()))) for item in details})
        raise ConfigurationError(fields) from error


def run_server(*args: Any, **kwargs: Any) -> None:
    import uvicorn

    uvicorn.run(*args, **kwargs)


def main(
    argv: Sequence[str] | None = None,
    *,
    settings_loader: Callable[[], Any] = load_settings,
    server_runner: Callable[..., None] = run_server,
) -> int:
    try:
        settings = settings_loader()
    except ConfigurationError as error:
        fields = ", ".join(error.fields) or "desconhecida"
        hint = (
            "AI_SAFETY_API_TOKEN deve ter pelo menos 16 caracteres."
            if "api_token" in error.fields
            else "Corrija os campos informados no arquivo .env."
        )
        raise SystemExit(
            f"Configuração inválida em {API_ROOT / '.env'} (campos: {fields}). "
            f"{hint}"
        ) from error
    args = build_parser(settings).parse_args(argv)

    server_runner(
        "app.main:create_app",
        factory=True,
        host=args.host,
        port=args.port,
        log_level=args.log_level,
        server_header=False,
    )
    return 0


if __name__ == "__main__":
    ensure_virtualenv()
    raise SystemExit(main())
