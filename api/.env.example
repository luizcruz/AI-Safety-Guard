# Gere um token aleatório exclusivo com pelo menos 32 caracteres.
AI_SAFETY_API_TOKEN=

# Chave exclusiva para autenticar o login do painel administrativo.
AI_SAFETY_ADMIN_KEY=

# O padrão restringe o acesso à máquina local.
AI_SAFETY_API_HOST=127.0.0.1
AI_SAFETY_API_PORT=8000
AI_SAFETY_LOG_LEVEL=info
